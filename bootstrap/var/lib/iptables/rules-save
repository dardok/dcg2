# NAT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A POSTROUTING -s 192.168.180.0/23 ! -d 192.168.180.0/23 -j MASQUERADE
COMMIT

# FILTER
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:input_ext - [0:0]
:input_int - [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m state --state ESTABLISHED -j ACCEPT
-A INPUT -p icmp -m state --state RELATED -j ACCEPT
-A INPUT -i enp65s0f0np0 -j input_ext
-A INPUT -i eno1np0 -j input_int
-A INPUT -i enp129s+ -j input_int
-A INPUT -i enp1s+ -j input_int
-A INPUT -m limit --limit 3/min -j LOG --log-prefix "IPT-IN-ILL-TARGET " --log-tcp-options --log-ip-options
-A INPUT -j DROP
-A FORWARD -i enp5s0 -o enp1s0f0 -m state --state RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -s 192.168.180.0/23 ! -d 10.0.0.0/8 -i enp65s0f0np0 -o eno1np0 -j ACCEPT
-A FORWARD -m limit --limit 3/min -j LOG --log-prefix "IPT-FWD-ILL-ROUTING " --log-tcp-options --log-ip-options
-A input_ext -p icmp -m icmp --icmp-type 4 -j ACCEPT
-A input_ext -p icmp -m icmp --icmp-type 8 -j ACCEPT
-A input_ext -s 134.207.18.22/32 -m comment --comment "003 dns drop ieapp" -j DROP
-A input_ext -s 134.207.18.23/32 -m comment --comment "003 dns drop iecac" -j DROP
-A input_ext -s 134.207.18.24/32 -m comment --comment "003 dns drop iecoop" -j DROP
-A input_ext -s 134.207.23.10/32 -m comment --comment "003 dns drop iedb" -j DROP
-A input_ext -s 134.207.0.0/20 -m comment --comment cmf -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A input_ext -s 134.207.18.73/32 -m comment --comment fermi -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A input_ext -s 134.207.182.0/23 -m comment --comment ld2 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A input_ext -m limit --limit 3/min -m pkttype --pkt-type multicast -j LOG --log-prefix "IPT-INext-DROP-DEFLT " --log-tcp-options --log-ip-options
-A input_ext -m pkttype --pkt-type multicast -j DROP
-A input_ext -m pkttype --pkt-type broadcast -j DROP
-A input_ext -p icmp -m limit --limit 3/min -j LOG --log-prefix "IPT-INext-DROP-DEFLT " --log-tcp-options --log-ip-options
-A input_ext -p tcp -m limit --limit 3/min -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -j LOG --log-prefix "IPT-INext-DROP-DEFLT " --log-tcp-options --log-ip-options
-A input_ext -p udp -m limit --limit 3/min -m state --state NEW -j LOG --log-prefix "IPT-INext-DROP-DEFLT " --log-tcp-options --log-ip-options
-A input_ext -j DROP
-A input_int -j ACCEPT
COMMIT

# RAW
*raw
:PREROUTING ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A PREROUTING -i lo -j NOTRACK
-A OUTPUT -o lo -j NOTRACK
COMMIT

module dcg-base 1.0;

require {
	type auditctl_t;
	type auditd_etc_t;
	type auditd_log_t;
	type auditd_t;
	type bin_t;
	type bootloader_t;
	type cgroup_t;
	type chkpwd_t;
	type dosfs_t;
	type fs_t;
	type getty_t;
	type init_t;
	type kernel_t;
	type kmod_t;
	type lvm_t;
	type mount_runtime_t;
	type nsfs_t;
	type proc_t;
	type restorecond_exec_t;
	type security_t;
	type selinux_config_t;
	type ssh_home_t;
	type sshd_t;
	type staff_t;
	type sysadm_systemd_t;
	type sysadm_t;
	type sysfs_t;
	type syslogd_t;
	type systemd_generator_t;
	type systemd_journal_init_t;
	type systemd_modules_load_t;
	type systemd_networkd_t;
	type systemd_nsresourced_t;
	type systemd_pcrphase_t;
	type systemd_sessions_t;
	type systemd_tmpfiles_t;
	type systemd_unit_t;
	type systemd_user_runtime_dir_t;
	type systemd_userdbd_runtime_t;
	type systemd_userdbd_t;
	type tmpfs_t;
	type udev_runtime_t;
	type udev_t;
	type unlabeled_t;
	type user_home_dir_t;
	class capability { dac_read_search mknod net_admin };
	class capability2 { bpf perfmon };
	class dir { add_name getattr open read search write };
	class file { execute getattr ioctl map open read };
	class filesystem getattr;
	class lnk_file { create getattr read };
	class process { dyntransition noatsecure rlimitinh siginh };
	class security read_policy;
	class sock_file { create write };
	class system firmware_load;
	class unix_stream_socket connectto;
}

#============= auditctl_t ==============
allow auditctl_t auditd_etc_t:file map;

#============= auditd_t ==============
allow auditd_t auditd_etc_t:file map;

#============= kernel_t ==============
allow kernel_t self:system firmware_load;

#============= lvm_t ==============
allow lvm_t unlabeled_t:dir search;

#============= sshd_t ==============
allow sshd_t chkpwd_t:process { noatsecure rlimitinh siginh };
allow sshd_t staff_t:process { noatsecure rlimitinh siginh };

#============= sysadm_systemd_t ==============
allow sysadm_systemd_t sysadm_t:process { noatsecure siginh };

#============= systemd_generator_t ==============
allow systemd_generator_t tmpfs_t:dir read;
allow systemd_generator_t unlabeled_t:dir { getattr search };

#============= systemd_modules_load_t ==============
allow systemd_modules_load_t cgroup_t:file { getattr ioctl open read };
allow systemd_modules_load_t tmpfs_t:dir read;

#============= systemd_networkd_t ==============
allow systemd_networkd_t mount_runtime_t:file { open read };

#============= systemd_nsresourced_t ==============
allow systemd_nsresourced_t fs_t:filesystem getattr;
allow systemd_nsresourced_t self:capability net_admin;

#============= systemd_pcrphase_t ==============
allow systemd_pcrphase_t dosfs_t:dir { getattr search };
allow systemd_pcrphase_t dosfs_t:file { getattr open read };
allow systemd_pcrphase_t nsfs_t:file getattr;
allow systemd_pcrphase_t sysfs_t:filesystem getattr;
allow systemd_pcrphase_t systemd_userdbd_runtime_t:dir search;
allow systemd_pcrphase_t systemd_userdbd_runtime_t:sock_file write;
allow systemd_pcrphase_t systemd_userdbd_t:unix_stream_socket connectto;
allow systemd_pcrphase_t udev_runtime_t:dir search;
allow systemd_pcrphase_t udev_runtime_t:file { getattr open read };

#============= systemd_tmpfiles_t ==============
allow systemd_tmpfiles_t tmpfs_t:lnk_file { create getattr read };

#============= udev_t ==============
allow udev_t lvm_t:process { noatsecure rlimitinh siginh };
